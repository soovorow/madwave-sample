{
    "name": "yiisoft/yii2-app-advanced",
    "description": "Yii 2 Advanced Application Template",
    "keywords": ["yii2", "framework", "advanced", "application template"],
    "homepage": "http://www.yiiframework.com/",
    "type": "project",
    "license": "BSD-3-Clause",
    "support": {
        "issues": "https://github.com/yiisoft/yii2/issues?state=open",
        "forum": "http://www.yiiframework.com/forum/",
        "wiki": "http://www.yiiframework.com/wiki/",
        "irc": "irc://irc.freenode.net/yii",
        "source": "https://github.com/yiisoft/yii2"
    },
    "minimum-stability": "stable",
    "require": {
        "php": ">=7.0.0",
        "yiisoft/yii2": "*",
        "yiisoft/yii2-bootstrap": "*",
        "yiisoft/yii2-swiftmailer": "*",
        "yiisoft/yii2-httpclient": "~2.0.0",
        "yiisoft/yii2-authclient": "~2.1.0",
        "yiisoft/yii2-jui": "~2.0.0",
        "yiisoft/yii2-imagine": "*",

        "omnilight/yii2-shopping-cart": "~1.0",
        "baibaratsky/yii2-ga-measurement-protocol": "1.1.*",
        "himiklab/yii2-recaptcha-widget" : "*",

        "google/apiclient": "^2.0",
        "drewm/mailchimp-api": "^2.2",
        "mandrill/mandrill": "^1.0",

        "vova07/yii2-imperavi-widget": "*",
        "bower-asset/theia-sticky-sidebar" : "*",
        "kop/yii2-scroll-pager": "dev-master",
        "vinkla/instagram": "*",

        "soovorow/yii2-product-features-module" : "@dev",
        "bizley/migration": "^2.2",
        "urmaul/yii2-slack-log": "~2.0",
        "kunalvarma05/dropbox-php-sdk": "^0.2.1",
        "php-http/message": "^1.6",
        "php-http/guzzle6-adapter": "^1.1",
        "richweber/yii2-google-translate-api": "dev-master"
    },
    "require-dev": {
        "yiisoft/yii2-debug": "*",
        "yiisoft/yii2-gii": "*",
        "yiisoft/yii2-faker": "*",
        "phpstan/phpstan": "^0.6.4",
        "codeception/base": "^2.2.3",
        "codeception/verify": "~0.3.1",
        "codeception/specify": "*",
        "redmatter/codeception-multidb": " ~2.0@dev"
    },
    "config": {
        "process-timeout": 1800
    },
    "repositories": [
        {
            "type": "composer",
            "url": "https://asset-packagist.org"
        }
    ],
    "extra": {
        "asset-installer-paths": {
            "npm-asset-library": "vendor/npm",
            "bower-asset-library": "vendor/bower"
        }
    }
}
